{
  "name": "neonfetch",
  "version": "5.9.1",
  "private": true,
  "description": "High-tech public media downloader for files you own or are authorized to download.",
  "type": "module",
  "scripts": {
    "postinstall": "node ./postinstall.mjs",
    "start": "node --import ./instagram-auth-patch.mjs --import ./youtube-auth-patch.mjs --import ./youtube-render-failover-patch.mjs --import ./deno-youtube-patch.mjs --import ./streamlink-dm-patch.mjs --import ./direct-link-patch.mjs server-v5.js",
    "dev": "node --watch --import ./instagram-auth-patch.mjs --import ./youtube-auth-patch.mjs --import ./youtube-render-failover-patch.mjs --import ./deno-youtube-patch.mjs --import ./streamlink-dm-patch.mjs --import ./direct-link-patch.mjs server-v5.js",
    "companion": "node local-companion.mjs",
    "youtube-local": "node youtube-local.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@sparticuz/chromium": "153.0.0",
    "express": "^4.21.2",
    "ffmpeg-static": "5.3.0",
    "youtube-dl-exec": "^3.1.15"
  }
}
