{
  "name": "neonfetch",
  "version": "5.4.0",
  "private": true,
  "description": "High-tech public media downloader for files you own or are authorized to download.",
  "type": "module",
  "scripts": {
    "postinstall": "python3 -m pip install --disable-pip-version-check --no-cache-dir --upgrade --pre --target ./pydeps streamlink==8.5.0 \"yt-dlp[default]\"",
    "start": "node --import ./instagram-auth-patch.mjs --import ./youtube-auth-patch.mjs --import ./streamlink-dm-patch.mjs --import ./direct-link-patch.mjs server-v5.js",
    "dev": "node --watch --import ./instagram-auth-patch.mjs --import ./youtube-auth-patch.mjs --import ./streamlink-dm-patch.mjs --import ./direct-link-patch.mjs server-v5.js",
    "youtube-local": "node youtube-local.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ffmpeg-static": "5.3.0",
    "youtube-dl-exec": "^3.1.15"
  }
}